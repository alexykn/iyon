{
  "name": "iyon-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "plugins/agents/*",
    "plugins/app/*",
    "plugins/providers/*",
    "plugins/tools/*"
  ],
  "scripts": {
    "workspace:install": "bun install",
    "check:bun-version": "bun run packages/iyon-runtime/scripts/check-bun-version.ts",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:plugins": "bunx tsc --noEmit -p packages/iyon-plugins/tsconfig.json",
    "test:plugins": "bun test packages/iyon-plugins/tests packages/iyon-plugins/test",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --workspace",
    "native:stage": "bun run packages/iyon-runtime/scripts/stage-native.ts",
    "native:tui:stage": "bun run node_modules/.bin/iyon-tui-native-stage",
    "smoke": "bun run packages/iyon-cli/src/index.ts",
    "test": "bun test",
    "t4:check": "cargo run -p api-surface -- check --config tools/api-surface/surface.toml && bun test packages/iyon-runtime/tests packages/iyon-runtime/test packages/iyon-sdk/tests",
    "t5:check": "cargo run -p api-surface -- check --config tools/api-surface/surface.toml && bun run typecheck && bun test packages/iyon-runtime/tests packages/iyon-runtime/test packages/iyon-sdk/tests",
    "check:ownership": "bun run tools/ownership/check.ts",
    "build:standalone": "bun run native:stage && bun run native:tui:stage && bun run packages/iyon-runtime/scripts/stage-native.ts --standalone",
    "build:iyon": "bun run packages/iyon-cli/build-perf-refactor.ts",
    "build:iyon:perf-refactor": "bun run build:iyon -- perf-refactor",
    "clean:iyon": "bun run packages/iyon-cli/build-perf-refactor.ts --clean"
  },
  "dependencies": {
    "@iyon/cli": "workspace:*",
    "@iyon/runtime": "workspace:*",
    "@iyon/plugins": "workspace:*",
    "@iyon/sdk": "workspace:*",
    "@iyon/tui": "github:alexykn/iyon-tui#a26a7f4f0a40a05a9e335b40daad92c777da2cbd"
  },
  "devDependencies": {
    "bun-types": "1.4.0"
  }
}
