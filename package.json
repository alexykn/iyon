{
  "name": "iyon-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "workspace:install": "bun install",
    "typecheck": "bunx tsc --noEmit",
    "native:stage": "bun run packages/iyon-runtime/scripts/stage-native.ts",
    "native:verify": "bun run packages/iyon-runtime/scripts/verify-native.ts",
    "smoke": "bun run packages/iyon-cli/src/index.ts",
    "test": "bun test",
    "build:standalone": "bun run packages/iyon-runtime/scripts/stage-native.ts --standalone"
  },
  "dependencies": {
    "@iyon/cli": "workspace:*",
    "@iyon/runtime": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
